# MSC resting-state scans: 10 x 206 MB, over GitHub's 100 MB per-file limit.
# Fetch from OpenNeuro ds000224 (derivatives/surface_pipeline) into data/msc/.
data/msc/

# Derived and reproducible: caches, simulation output, videos.
data/cache/
results/*
!results/fc/
results/fc/*
# ...except the group FC target. Everything is scored against it, it is not rebuildable
# without the RBC DataLad clone, and a fresh checkout - a cloud session included - can
# otherwise build a mesh and a basis but has nothing to compare them to. 331 MiB, so it
# goes through Git LFS; see .gitattributes.
!results/fc/group-RBCNKI100_hemi-L_space-fsaverage5_mask-glasser_spearmanfc.npy
!results/fc/group-RBCNKI100_hemi-L_space-fsaverage5_mask-glasser_vertices.npy
!results/fc/group-RBCNKI100_hemi-L_space-fsaverage5_mask-glasser_meta.json

# local tool config
.claude/

__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
.venv/
venv/

# RBC (ReproBrainChart) DataLad clones: NKI only. Large, and fetched on demand.
data/rbc/

# Ascending-input atlases and the group dMRI template. The manifest JSON and
